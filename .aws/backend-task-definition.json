{
  "family": "mainto-backend-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::209479305143:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "mainto-backend-container",
      "image": "209479305143.dkr.ecr.us-east-1.amazonaws.com/mainto-backend:latest",
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "essential": true,

      "environment": [
        { "name": "DATABASE_URL", "value": "${{ secrets.DATABASE_URL }}" }

        
      ],

      "secrets": [
        {
          "name": "GOOGLE_SERVICE_ACCOUNT_JSON_B64",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:209479305143:secret:mainto/google-service-account-rSEnKF"
        },
        {
          "name": "GOOGLE_SERVICE_ACCOUNT_JSON",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:209479305143:secret:GOOGLE_SERVICE_ACCOUNT_JSON-hBpWqH"
        },
        {
    "name": "DATABASE_URL",
    "valueFrom": "arn:aws:secretsmanager:us-east-1:209479305143:secret:mainto-app-secrets-an1UNW"
  },
  {
    "name": "CASHFREE_APP_ID",
    "valueFrom": "arn:aws:secretsmanager:us-east-1:209479305143:secret:mainto-app-all-secrets-hCP1Ga:CASHFREE_APP_ID::"
  },
  {
    "name": "CASHFREE_SECRET_KEY",
    "valueFrom": "arn:aws:secretsmanager:us-east-1:209479305143:secret:mainto-app-all-secrets-hCP1Ga:CASHFREE_SECRET_KEY::"
  },
  {
    "name": "WHATSAPP_ACCESS_TOKEN",
    "valueFrom": "arn:aws:secretsmanager:us-east-1:209479305143:secret:mainto-app-all-secrets-hCP1Ga:WHATSAPP_ACCESS_TOKEN::"
  },
  {
    "name": "WHATSAPP_PHONE_ID",
    "valueFrom": "arn:aws:secretsmanager:us-east-1:209479305143:secret:mainto-app-all-secrets-hCP1Ga:WHATSAPP_PHONE_ID::"
  },
  {
    "name": "WHATSAPP_VERIFY_TOKEN",
    "valueFrom": "arn:aws:secretsmanager:us-east-1:209479305143:secret:mainto-app-all-secrets-hCP1Ga:WHATSAPP_VERIFY_TOKEN::"
  },
  {
    "name": "ENV",
    "valueFrom": "arn:aws:secretsmanager:us-east-1:209479305143:secret:mainto-app-all-secrets-hCP1Ga:ENV::"
  },
  {
    "name": "PLATFORM_FEE_PERCENT",
    "valueFrom": "arn:aws:secretsmanager:us-east-1:209479305143:secret:mainto-app-all-secrets-hCP1Ga:PLATFORM_FEE_PERCENT::"
  },
  {
    "name": "JWT_SECRET",
    "valueFrom": "arn:aws:secretsmanager:us-east-1:209479305143:secret:mainto-app-all-secrets-hCP1Ga:JWT_SECRET::"
  },
  {
    "name": "JWT_ALGORITHM",
    "valueFrom": "arn:aws:secretsmanager:us-east-1:209479305143:secret:mainto-app-all-secrets-hCP1Ga:JWT_ALGORITHM::"
  },
  {
    "name": "JWT_EXPIRES_MIN",
    "valueFrom": "arn:aws:secretsmanager:us-east-1:209479305143:secret:mainto-app-all-secrets-hCP1Ga:JWT_EXPIRES_MIN::"
  }
      ],

      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/mainto-backend",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
