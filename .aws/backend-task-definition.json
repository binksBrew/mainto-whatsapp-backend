{
  "family": "mainto-backend-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::209479305143:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "mainto-backend-container",
      "image": "209479305143.dkr.ecr.us-east-1.amazonaws.com/mainto-backend:latest",
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "DATABASE_URL",
          "value": "${{ secrets.DATABASE_URL }}"
        },
        {
          "name": "CASHFREE_APP_ID",
          "value": "${{ secrets.CASHFREE_APP_ID }}"
        },
        {
          "name": "CASHFREE_SECRET_KEY",
          "value": "${{ secrets.CASHFREE_SECRET_KEY }}"
        },
        {
          "name": "GOOGLE_SERVICE_ACCOUNT_JSON_B64",
          "valueFrom": "arn:aws:ssm:us-east-1:209479305143:parameter/GOOGLE_SERVICE_ACCOUNT_JSON_B64"
        }
        {
          "name": "WHATSAPP_ACCESS_TOKEN",
          "value": "${{ secrets.WHATSAPP_ACCESS_TOKEN }}"
        },
        {
          "name": "WHATSAPP_PHONE_ID",
          "value": "${{ secrets.WHATSAPP_PHONE_ID }}"
        },
        {
          "name": "WHATSAPP_VERIFY_TOKEN",
          "value": "${{ secrets.WHATSAPP_VERIFY_TOKEN }}"
        },
        {
          "name": "ENV",
          "value": "${{ secrets.ENV }}"
        },
        {
          "name": "PLATFORM_FEE_PERCENT",
          "value": "${{ secrets.PLATFORM_FEE_PERCENT }}"
        },
        {
          "name": "JWT_SECRET",
          "value": "${{ secrets.JWT_SECRET }}"
        },
        {
          "name": "JWT_ALGORITHM",
          "value": "${{ secrets.JWT_ALGORITHM }}"
        },
        {
          "name": "JWT_EXPIRES_MIN",
          "value": "${{ secrets.JWT_EXPIRES_MIN }}"
        },
        {
          "name": "GOOGLE_SERVICE_ACCOUNT_JSON",
          "value": "${{ secrets.GOOGLE_SERVICE_ACCOUNT_JSON }}"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/mainto-backend",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
